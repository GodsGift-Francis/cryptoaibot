APP_NAME="Crypto Trading Control Plane"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/laravel/database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true

# Must equal CONTROL_PLANE_TOKEN in the engine .env (>= 32 random characters)
TRADING_BOT_INTERNAL_TOKEN=CHANGE_THIS_LONG_RANDOM_SECRET
BOT_INSTANCE_ID=default
INTERNAL_API_MAX_SKEW_SECONDS=300
BOT_HEARTBEAT_STALE_SECONDS=180
INTERNAL_REQUEST_RETENTION_DAYS=14

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# >= 16 random characters; part of the webhook URL
TELEGRAM_WEBHOOK_SECRET=
