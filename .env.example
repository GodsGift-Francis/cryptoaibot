# ============================================================================
# Crypto bot engine (Python) - copy to .env. NEVER commit .env.
# ============================================================================

# --- Mode: PAPER -> TESTNET -> LIVE. PAPER is the default. ---
TRADING_MODE=PAPER
# LIVE is refused unless this is exactly true AND PROTECTIVE_STOP_MODE=exchange.
LIVE_TRADING_CONFIRMED=false
# false = no new entries anywhere (exits still allowed)
GLOBAL_TRADING_ENABLED=true

# --- Exchange (Binance Spot). Needed for TESTNET/LIVE only. ---
# Key permissions: Spot TRADE (+ USER_DATA/USER_STREAM). NEVER enable withdrawals.
# Restrict the key to your server's IP address in Binance API management.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Label used inside event idempotency keys (never the API key itself)
BINANCE_ACCOUNT_LABEL=main
# Optional override; defaults to testnet for PAPER/TESTNET and production for LIVE
# BINANCE_WS_API_URL=wss://ws-api.testnet.binance.vision/ws-api/v3

TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1h

# --- Risk (unchanged V1 values) ---
STARTING_PAPER_BALANCE=1000
RISK_PER_TRADE_PCT=1
STOP_LOSS_PCT=3
DAILY_LOSS_LIMIT_PCT=5
MAX_OPEN_POSITIONS=1

# --- Execution ---
CLIENT_ORDER_ID_PREFIX=cb1
PAPER_FEE_RATE=0
# software (PAPER/TESTNET) | exchange (resting STOP_LOSS_LIMIT on Binance; required for LIVE)
PROTECTIVE_STOP_MODE=software
PROTECTIVE_STOP_LIMIT_OFFSET_PCT=0.5
AMBIGUOUS_ORDER_GRACE_SECONDS=60
# true = evaluate the last CLOSED candle (matches backtester). false = V1 forming-candle behavior.
SIGNAL_ON_CLOSED_CANDLES=true

# --- Reconciliation / WebSocket ---
RECON_STATE_MAX_AGE_SECONDS=90
RECONCILE_INTERVAL_SECONDS=300
RECENT_FILLS_LOOKBACK_HOURS=48
WS_PING_INTERVAL_SECONDS=30
WS_RESPONSE_TIMEOUT_SECONDS=10
WS_MAX_BACKOFF_SECONDS=60

# --- Laravel control plane (must match laravel/.env TRADING_BOT_INTERNAL_TOKEN) ---
CONTROL_PLANE_URL=http://127.0.0.1:8000
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
CONTROL_PLANE_TOKEN=CHANGE_THIS_LONG_RANDOM_SECRET
BOT_INSTANCE_ID=default
REQUEST_TIMEOUT_SECONDS=10

# --- Operator alerts (engine -> Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
LOOP_INTERVAL_SECONDS=900
HEARTBEAT_INTERVAL_SECONDS=30
ENGINE_DB_PATH=var/engine.sqlite3
LOG_LEVEL=INFO

# --- Strategy parameters (defaults = V1). Only change to a config that passed research/out/REPORT.md gates. ---
SCORE_BUY_THRESHOLD=2.5
SCORE_SELL_THRESHOLD=-2.5

# --- AI layer (research/ml.py). Keep v1 until a model passes the ML gates AND the one-shot holdout. ---
STRATEGY_MODE=v1
# ML_MODEL_PATH=/opt/crypto-bot/research/out/model/model.joblib
# ML_MODEL_SHA256=
